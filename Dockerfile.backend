FROM docker.io/library/rust:1.99-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p cr-service && cp target/release/cr-service /tmp/cr-service

FROM docker.io/library/debian:bookworm-slim
RUN useradd --system --uid 10001 --create-home canopy
COPY --from=build /tmp/cr-service /usr/local/bin/cr-service
RUN mkdir /data && chown canopy:canopy /data
USER canopy
ENV CANOPY_RELAY_ADDR=0.0.0.0:18080 CANOPY_RELAY_DATA=/data
EXPOSE 18080
CMD ["cr-service"]
