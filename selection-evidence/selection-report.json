  "product": {
    "users": "Ecological field coordinators, restoration scientists, and incident commanders operating habitat programs across intermittent links",
    "capability": "A camera-free ecological operations digital twin that verifies observations, builds provenance-rich habitat state, detects temporal anomalies, forecasts risk, routes offline evidence, authorizes interventions, and durably retrieves audits",
    "bounded_contexts": ["Field Observation Trust", "Habitat State Intelligence", "Intervention Governance", "Constrained-Link Coordination", "Audit Stewardship"],
    "topology": {
      "frontend": "React and TypeScript habitat operations console with six domain views",
      "backend": "Axum Rust service composing meaningful domain and application crates",
      "middleware": "Ordered authentication, authorization, policy, validation, error, correlation, timeout, and telemetry layers",
      "persistence": "Apache OpenDAL object boundary for durable observation, intervention, and audit records"
    },
    "workflows": [
      {"name": "primary", "user_outcome": "A field lead submits an observation and receives a verified, spatially enriched, anomaly-scored, forecast, mesh-routed habitat assessment with an audit read-back"},
      {"name": "denial-recovery", "user_outcome": "A restricted intervention is denied before any downstream write, then a permitted mesh-relay intervention is authorized and recorded"},
      {"name": "durable-retrieval", "user_outcome": "A saved intervention and its audit are restored after browser refresh and backend restart"}
    ]
  },
